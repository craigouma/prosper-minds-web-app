# ProsperMinds CPD subdomain (cpd.prosper-minds.com) — environment configuration.
#
# Copy this file to `.env` in the same directory and fill in the real values:
#     cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored and is blocked from the web by the dotfile rule in
# .htaccess. To keep it outside the document root entirely, put it anywhere
# readable by PHP and set CPD_ENV_FILE to its absolute path in the server
# environment.
#
# Anything set as a real server environment variable (cPanel "Environment
# Variables", or SetEnv in the vhost) wins over this file.
#
# NOTE: the main site uses the SAME variable names with DIFFERENT values. The
# two sites must not share one .env file.
#
# Parsing is literal: everything after the first "=" is the value. There is no
# inline-comment stripping and no $VAR interpolation, so passwords containing
# # $ { } & etc. can be pasted verbatim.

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# DB_USER, DB_PASS and DB_NAME have no fallback. If they are missing, every
# page returns "Site configuration is incomplete."
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASS=replace_with_database_password

# ── SMTP (OPTIONAL, but mail is dead without it) ─────────────────────────────
# SMTP_USER and SMTP_PASS have no default. While either is unset, sendEmail()
# logs "SMTP is not configured" and returns without connecting — registrations
# still save and still redirect to success.php, they just send no email.
#
# NOTE FOR WHOEVER FILLS THIS IN: the value previously hardcoded for the SMTP
# password was the mailbox address itself, i.e. the same string as the
# username. That is almost certainly a placeholder that was never replaced, so
# treat the real password as unknown and fetch it from cPanel rather than
# assuming the old value worked.
#
# SMTP_SECURE accepts: tls (STARTTLS, port 587), ssl (implicit TLS, port 465),
# or none.
SMTP_HOST=mail.prosper-minds.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# Envelope From. Defaults to ADMIN_EMAIL when blank.
SMTP_FROM_EMAIL=

# ── Addresses (OPTIONAL) ─────────────────────────────────────────────────────
# Where admin notifications go. Defaults to info@prosper-minds.com.
ADMIN_EMAIL=info@prosper-minds.com
COMPANY_NAME=ProsperMinds

# Local development against the Mailpit container from ../docker-compose.yml:
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025
#   SMTP_SECURE=none
#   SMTP_USER=local@example.test
#   SMTP_PASS=anything-mailpit-accepts-any
#   ADMIN_EMAIL=admin@example.test
